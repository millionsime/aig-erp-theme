d>\n    </tr>\n  </table>\n\n  <table class=\"grid\">\n    <tr><th>#</th><th>Item Code</th><th>Description</th><th class=\"right\">Qty Issued</th><th>UOM</th><th>Bin</th></tr>\n    {% for row in (doc.items or []) %}\n    <tr>\n      <td>{{ row.idx }}</td>\n      <td>{{ row.item_code or '' }}</td>\n      <td>{{ row.item_name or row.description or '' }}</td>\n      <td class=\"right\">{{ row.qty }}</td>\n      <td>{{ row.uom or '' }}</td>\n      <td>{{ row.aig_bin_location or '' }}</td>\n    </tr>\n    {% endfor %}\n  </table>\n\n  <table class=\"sig\">\n    <tr>\n      <td>Issued By (Store Keeper)</td>\n      <td>Received By (End User)</td>\n      <td>Authorized (Main Store Admin)</td>\n    </tr>\n  </table>\n  <div class='note'>AIG configurable print template. Original form artwork / pre-printed numbering not supplied - replace this layout with the official form if required. Generated {{ frappe.utils.now() }}.</div>\n</div>\n",
